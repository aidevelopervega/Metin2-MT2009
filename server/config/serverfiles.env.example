# ==============================================================================
# Metin2 MT2009 Serverfiles — Local Environment & Credential Template
# ==============================================================================
# IMPORTANT SECURITY NOTICE:
# 1. Copy this file to `server/config/serverfiles.env` (or `$SFROOT/serverfiles.env`)
#    and replace every `__CHANGE_ME_*__` placeholder with real secrets.
# 2. NEVER commit `serverfiles.env` or real passwords/keys to Git.
# 3. Restrict file permissions before starting the server:
#    - FreeBSD: chmod 600 serverfiles.env db/conf.txt auth/CONFIG chs/*/CONFIG
#    - Windows: icacls serverfiles.env /inheritance:r /grant:r "$($env:USERNAME):(R,W)"
# 4. Least-Privilege SQL User Separation (MariaDB 12.3 LTS):
#    NEVER run game/db services as `root`, NEVER use `'%'` wildcard host grants,
#    and NEVER grant `ALL PRIVILEGES ON *.*`, `SUPER`, `FILE`, `CREATE USER`,
#    `GRANT OPTION`, `SHUTDOWN`, `CREATE`, `ALTER`, or `DROP` to runtime accounts.
#    Separate schema initialization/migration (`MT2_INIT_DB_USER`), core runtime
#    DML (`MT2_DB_USER`), and isolated SQL logging (`MT2_LOG_DB_USER`):
#
#    CREATE DATABASE IF NOT EXISTS account CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci;
#    CREATE DATABASE IF NOT EXISTS common  CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci;
#    CREATE DATABASE IF NOT EXISTS log     CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci;
#    CREATE DATABASE IF NOT EXISTS player  CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci;
#    CREATE DATABASE IF NOT EXISTS world   CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci;
#
#    -- Runtime Game/DB DML account (NO DDL, NO global privileges, NO log.*, SELECT-only on world.*):
#    -- RESIDUAL DML RISK NOTE: Because normal gameplay requires UPDATE/DELETE on `player.*`
#    -- (`item`, `quest`, `affect`, `player`) and `account.hardware_status`, blocking DDL alone
#    -- does NOT prevent destructive UPDATE/DELETE if `mt2server` is compromised. Always pair
#    -- with `QUERY_DML_NO_SELECT` auditing and off-VM encrypted backups via `mt2backup`.
#    CREATE USER IF NOT EXISTS 'mt2server'@'127.0.0.1' IDENTIFIED BY '<STRONG_DB_PASSWORD>';
#    CREATE USER IF NOT EXISTS 'mt2server'@'localhost' IDENTIFIED BY '<STRONG_DB_PASSWORD>';
#    GRANT SELECT, INSERT, UPDATE, DELETE ON account.* TO 'mt2server'@'127.0.0.1', 'mt2server'@'localhost';
#    GRANT SELECT, INSERT, UPDATE, DELETE ON common.*  TO 'mt2server'@'127.0.0.1', 'mt2server'@'localhost';
#    GRANT SELECT, INSERT, UPDATE, DELETE ON player.*  TO 'mt2server'@'127.0.0.1', 'mt2server'@'localhost';
#    GRANT SELECT                         ON world.*   TO 'mt2server'@'127.0.0.1', 'mt2server'@'localhost';
#
#    -- Dedicated SQL Log account (restricted strictly to `log.*`; zero access to `account`/`player`/`common`/`world`):
#    CREATE USER IF NOT EXISTS 'mt2log'@'127.0.0.1' IDENTIFIED BY '<STRONG_LOG_DB_PASSWORD>';
#    CREATE USER IF NOT EXISTS 'mt2log'@'localhost' IDENTIFIED BY '<STRONG_LOG_DB_PASSWORD>';
#    GRANT SELECT, INSERT, UPDATE, DELETE ON log.* TO 'mt2log'@'127.0.0.1', 'mt2log'@'localhost';
#
#    -- Dedicated Read-Only Backup account (used only by `backup_mariadb.sh` / `backup_mariadb.ps1`):
#    CREATE USER IF NOT EXISTS 'mt2backup'@'127.0.0.1' IDENTIFIED BY '<STRONG_BACKUP_DB_PASSWORD>';
#    CREATE USER IF NOT EXISTS 'mt2backup'@'localhost' IDENTIFIED BY '<STRONG_BACKUP_DB_PASSWORD>';
#    GRANT SELECT, SHOW VIEW, TRIGGER, LOCK TABLES, EVENT ON account.* TO 'mt2backup'@'127.0.0.1', 'mt2backup'@'localhost';
#    GRANT SELECT, SHOW VIEW, TRIGGER, LOCK TABLES, EVENT ON common.*  TO 'mt2backup'@'127.0.0.1', 'mt2backup'@'localhost';
#    GRANT SELECT, SHOW VIEW, TRIGGER, LOCK TABLES, EVENT ON log.*     TO 'mt2backup'@'127.0.0.1', 'mt2backup'@'localhost';
#    GRANT SELECT, SHOW VIEW, TRIGGER, LOCK TABLES, EVENT ON player.*  TO 'mt2backup'@'127.0.0.1', 'mt2backup'@'localhost';
#    GRANT SELECT, SHOW VIEW, TRIGGER, LOCK TABLES, EVENT ON world.*   TO 'mt2backup'@'127.0.0.1', 'mt2backup'@'localhost';
#    FLUSH PRIVILEGES;
#
# 5. MariaDB 12.3 LTS Network & Server Audit Hardening (`my.cnf` / `my.ini`):
#    [mysqld]
#    bind-address = 127.0.0.1
#    local-infile = 0
#    symbolic-links = 0
#    sql-mode = STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION
#    plugin_load_add = server_audit
#    server_audit = FORCE_PLUS_PERMANENT
#    server_audit_events = CONNECT,QUERY_DDL,QUERY_DCL,QUERY_DML_NO_SELECT
#    server_audit_output_type = FILE
#    server_audit_file_path = mariadb_audit.log
#    server_audit_file_rotate_size = 104857600
#    server_audit_file_rotations = 90
#    server_audit_logging = ON
# ==============================================================================

# --- SQL Connection Settings (MariaDB 12.3 LTS) ---
MT2_DB_HOST=127.0.0.1
MT2_DB_BIND_ADDRESS=127.0.0.1
MT2_DB_PORT=3307
MT2_DB_USER=mt2server
MT2_DB_PASS=__CHANGE_ME_DB_PASSWORD__

# Dedicated SQL Log account (defaults to MT2_DB_USER / MT2_DB_PASS only if unset or placeholder)
MT2_LOG_DB_USER=mt2log
MT2_LOG_DB_PASS=__CHANGE_ME_LOG_DB_PASSWORD__

# Dedicated Read-Only Backup account (used by backup_mariadb.sh / backup_mariadb.ps1)
MT2_BACKUP_DB_USER=mt2backup
MT2_BACKUP_DB_PASS=__CHANGE_ME_BACKUP_DB_PASSWORD__
MT2_BACKUP_PASSPHRASE=__CHANGE_ME_BACKUP_ENCRYPTION_PASSPHRASE__
MT2_BACKUP_HMAC_SECRET=__CHANGE_ME_BACKUP_HMAC_SECRET__
MT2_BACKUP_DIR=/var/backups/mt2_mariadb
MT2_BACKUP_RETENTION_COUNT=14
MT2_BACKUP_MAX_TOTAL_MB=10240
MT2_MIN_FREE_DISK_MB=1024

# Optional: Schema Initialization / Migration account (used only by `install --init-sql` and `--restore`)
MT2_INIT_DB_USER=
MT2_INIT_DB_PASS=

# Optional: Path to MariaDB bin directory (Windows only, if not in PATH)
MT2_DB_BIN_DIR=

# --- Audit Log Protection & Remote Syslog Forwarding (audit_guard.sh) ---
MT2_AUDIT_MAX_MB=9216
MT2_AUDIT_WARN_PCT=80
MT2_AUDIT_ARCHIVE_MAX_FILES=30
MT2_AUDIT_SYSLOG_HOST=
MT2_AUDIT_SYSLOG_PORT=514

# --- Network & Service Bind Settings ---
MT2_BIND_IP=127.0.0.1
MT2_DB_ADDR=127.0.0.1
MT2_DB_LISTEN_PORT=18000
MT2_AUTH_PORT=17105
MT2_AUTH_P2P_PORT=19555

# --- Server Security & Admin Page Settings ---
MT2_ADMINPAGE_IP=127.0.0.1
MT2_ADMINPAGE_PASSWORD=__CHANGE_ME_ADMINPAGE_PASSWORD__
MT2_SERVER_KEY=__CHANGE_ME_SERVER_KEY__

# --- Account & Locale Defaults (DO NOT CHANGE social_id DEFAULT '1234567') ---
MT2_DEFAULT_SOCIAL_ID=1234567
MT2_LOCALE_SERVICE=poland

# --- Log Rotation Limits ---
MT2_LOG_MAX_BYTES=10485760
MT2_LOG_MAX_ARCHIVES=5

