#!/bin/sh
#
# PROVIDE: mt2server
# REQUIRE: DAEMON NETWORKING mysql
# KEYWORD: shutdown
#
# Add the following lines to /etc/rc.conf to enable mt2server (recommended non-root 'mt2' account):
#   pw groupadd mt2 -g 2009 && pw useradd mt2 -u 2009 -g mt2 -d /usr/home/mt2 -s /bin/sh
#   chown -R mt2:mt2 /usr/home/mt2
#   sysrc mt2server_enable="YES" mt2server_dir="/usr/home/mt2" mt2server_user="mt2"

. /etc/rc.subr

name="mt2server"
rcvar="mt2server_enable"

load_rc_config $name

: ${mt2server_enable:="NO"}
: ${mt2server_dir:="/usr/home/mt2"}
if [ -z "${mt2server_user:-}" ]; then
    if [ -d "${mt2server_dir}" ] && command -v stat >/dev/null 2>&1; then
        mt2server_user=$(stat -f '%Su' "${mt2server_dir}" 2>/dev/null || echo "root")
    elif id -u mt2 >/dev/null 2>&1; then
        mt2server_user="mt2"
    else
        mt2server_user="root"
    fi
fi

start_cmd="${name}_start"
stop_cmd="${name}_stop"
status_cmd="${name}_status"
extra_commands="status"

mt2server_start()
{
    if [ ! -x "${mt2server_dir}/start.sh" ]; then
        err 1 "${mt2server_dir}/start.sh not found or not executable"
    fi
    su -m "${mt2server_user}" -c "sh '${mt2server_dir}/start.sh'"
}

mt2server_stop()
{
    if [ ! -x "${mt2server_dir}/stop.sh" ]; then
        err 1 "${mt2server_dir}/stop.sh not found or not executable"
    fi
    su -m "${mt2server_user}" -c "sh '${mt2server_dir}/stop.sh'"
}

mt2server_status()
{
    if [ ! -x "${mt2server_dir}/status.sh" ]; then
        err 1 "${mt2server_dir}/status.sh not found or not executable"
    fi
    sh "${mt2server_dir}/status.sh"
}

run_rc_command "$1"
