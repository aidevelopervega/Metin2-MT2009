quest sample_biologist begin
    state start begin
        when login or enter with pc.get_level() >= 30 begin
            set_state(information)
        end
    end

    state information begin
        when 20084.chat."Orc Valley Research" begin
            say_title("Biologist Chaegirab:")
            say("Hello adventurer!")
            say("Please bring me 10 Orc Teeth.")
            set_state(collecting)
        end
    end

    state collecting begin
        when 20084.chat."Turn in Orc Teeth" begin
            say_title("Biologist Chaegirab:")
            if pc.count_item(30005) >= 10 then
                pc.remove_item(30005, 10)
                say("Thank you! Here is your reward.")
                set_state(__COMPLETE__)
            else
                say("You do not have enough teeth.")
            end
        end
    end

    state __COMPLETE__ begin
    end
end
